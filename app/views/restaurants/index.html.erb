<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Restaurants</h1>
    <%= link_to "Add a restaurant", new_restaurant_path, class: "btn btn-primary" %>
  </div>

  <div class="row">
    <% @restaurants.each do |restaurant| %>
      <div class="col-md-4 mb-4">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title"><%= restaurant.name %></h5>
            <p class="card-text text-muted"><%= restaurant.category.capitalize %></p>
            <p class="card-text"><%= restaurant.address %></p>
          </div>
          <div class="card-footer">
            <%= link_to "See details", restaurant_path(restaurant), class: "btn btn-outline-primary btn-sm" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
